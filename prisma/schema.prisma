generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InterestStatus {
  INTERESTED
  THINKING
  NOT_INTERESTED
  MUST_BUY
}

enum PurchaseStatus {
  UNRESERVED
  WAITING_OFFER
  RESERVED
  PARTIALLY_PAID
  PAID
  CANCELLED
  RECEIVED
  PLAYING
  COMPLETED
}

enum Availability {
  AVAILABLE
  PREORDER
  OUT_OF_STOCK
  UNKNOWN
}

enum PaymentType {
  RESERVATION
  PAYMENT
  REFUND
}

enum DiscoveryDecisionType {
  LIKED
  THINKING
  DISMISSED
  MUST_BUY
}

enum PlatformFamily {
  PLAYSTATION_5
  XBOX_SERIES
  NINTENDO_SWITCH
  NINTENDO_SWITCH_2
  PC
  OTHER
}

enum DateSource {
  RAWG
  MANUAL
  OFFICIAL
  UNKNOWN
}

enum CalendarView {
  MONTHLY
  TIMELINE
}

enum BudgetGrouping {
  RELEASE
  RESERVATION
  PAYMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  games              Game[]
  sessions           Session[]
  discoveryDecisions DiscoveryDecision[]
  userPreferences    UserPreferences?
}

model UserPreferences {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @unique @db.Uuid
  preferredPlatforms     PlatformFamily[] @default([])
  defaultDiscoveryMonths Int              @default(12)
  defaultCalendarView    CalendarView     @default(MONTHLY)
  defaultBudgetGrouping  BudgetGrouping   @default(RELEASE)
  hideDismissedGames     Boolean          @default(true)
  reduceMotion           Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id                       String         @id @default(uuid()) @db.Uuid
  userId                   String         @db.Uuid
  rawgId                   Int?
  title                    String
  slug                     String?
  coverUrl                 String?
  backgroundUrl            String?
  description              String?
  releaseDate              DateTime?      @db.Date
  earlyAccessDate          DateTime?      @db.Date
  dateSource               DateSource     @default(UNKNOWN)
  officialUrl              String?
  rawgUrl                  String?
  platforms                String[]       @default([])
  normalizedPlatforms      PlatformFamily[] @default([])
  genres                   String[]       @default([])
  developer                String?
  publisher                String?
  esrbRating               String?
  metacritic               Int?
  interestStatus           InterestStatus @default(THINKING)
  purchaseStatus           PurchaseStatus @default(UNRESERVED)
  selectedPlatform         String?
  selectedEdition          String?
  selectedStore            String?
  totalPrice               Decimal?       @db.Decimal(10, 2)
  amountPaid               Decimal        @default(0) @db.Decimal(10, 2)
  targetPrice              Decimal?       @db.Decimal(10, 2)
  reservationDate          DateTime?      @db.Date
  paymentDeadline          DateTime?      @db.Date
  orderNumber              String?
  purchaseUrl              String?
  includesBonus            Boolean        @default(false)
  bonusDescription         String?
  useEarlyAccessAsMainDate Boolean        @default(false)
  notes                    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers   StoreOffer[]
  payments PaymentHistory[]

  @@unique([userId, rawgId])
  @@index([userId])
  @@index([releaseDate])
  @@index([earlyAccessDate])
  @@index([interestStatus])
  @@index([purchaseStatus])
  @@index([selectedPlatform])
}

model StoreOffer {
  id               String       @id @default(uuid()) @db.Uuid
  gameId           String       @db.Uuid
  store            String
  edition          String?
  platform         String?
  price            Decimal      @db.Decimal(10, 2)
  shippingCost     Decimal      @default(0) @db.Decimal(10, 2)
  url              String?
  availability     Availability @default(UNKNOWN)
  includesBonus    Boolean      @default(false)
  bonusDescription String?
  checkedAt        DateTime     @default(now())
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model PaymentHistory {
  id          String      @id @default(uuid()) @db.Uuid
  gameId      String      @db.Uuid
  amount      Decimal     @db.Decimal(10, 2)
  paymentDate DateTime    @db.Date
  paymentType PaymentType
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([paymentDate])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DiscoveryDecision {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  rawgId      Int
  title       String
  slug        String?
  coverUrl    String?
  backgroundUrl String?
  releaseDate DateTime?              @db.Date
  platforms   String[]               @default([])
  genres      String[]               @default([])
  decision    DiscoveryDecisionType
  decidedAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawgId])
  @@index([userId])
  @@index([decision])
}
