{
  "name": "game-release-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Game Release Calendar — calendario personal de lanzamientos de videojuegos",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @grc/shared build && pnpm --parallel --filter @grc/client --filter @grc/server run dev",
    "build": "pnpm --filter @grc/shared build && pnpm prisma:generate && pnpm --filter @grc/client build && pnpm --filter @grc/server build",
    "start": "pnpm --filter @grc/server start",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\" \"server/src/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:embedded": "node scripts/start-embedded-pg.mjs",
    "db:use-embedded": "node scripts/use-embedded-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
